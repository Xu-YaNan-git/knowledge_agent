# MinerU API
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# OpenAI API
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=gpt-4o-mini
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=gpt-4o-mini
# 商品名识别模型
ITEM_MODEL=gpt-4o-mini

# Hosted MCP：填写可公开访问的 MCP 服务地址
HOSTED_MCP_SERVER_URL=https://your-mcp-server.example.com/mcp
HOSTED_MCP_SERVER_LABEL=web_search
HOSTED_MCP_AUTHORIZATION=
HOSTED_MCP_ALLOWED_TOOLS=
HOSTED_MCP_MODEL=gpt-5.6-sol
HOSTED_MCP_OPENAI_BASE_URL=https://api.openai.com/v1
HOSTED_MCP_OPENAI_API_KEY=

# Vector Database (Milvus)
# If a workstation proxy is configured, the application adds this host to NO_PROXY.
MILVUS_URL=http://192.168.85.10:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# Document Database (MongoDB)
MONGO_URL=mongodb://192.168.85.10:27017
MONGO_DB_NAME=kb001

# Durable metadata/task/evaluation collections are created automatically in this database.

# Object Storage (MinIO)
MINIO_ENDPOINT=192.168.85.10:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-real-password
MINIO_BUCKET_NAME=knowledge-base
MINIO_DOCUMENT_BUCKET_NAME=knowledge-base-documents
MINIO_IMG_DIR=images

# Local BGE-M3 embedding model
BGE_M3_PATH=D:/ai_models/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0

# GPT-based document reranker
TEXT_RERANK_MODEL=gpt-4o-mini
TEXT_RERANK_INSTRUCT=请根据问题与文档相关性返回每个文档的分数
WEB_SEARCH_TIMEOUT_SECONDS=90

# Background task leases and operations
TASK_LEASE_SECONDS=180
TASK_HEARTBEAT_SECONDS=30
TEMP_FILE_RETENTION_DAYS=7
SLOW_REQUEST_THRESHOLD_MS=2000

# Authentication (disabled by default for local compatibility)
AUTH_ENABLED=false
# Production must use a random value of at least 32 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=480
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Persistent per-user resource quotas (set to 0 to disable a quota)
QUERY_RATE_LIMIT_PER_MINUTE=30
IMPORT_RATE_LIMIT_PER_HOUR=20
EVALUATION_RATE_LIMIT_PER_HOUR=10
EXPORT_RATE_LIMIT_PER_HOUR=10
