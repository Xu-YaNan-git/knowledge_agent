# MinerU API
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# OpenAI API
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_API_BASE=https://api.openai.com/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=gpt-4o-mini
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=gpt-4o-mini
# 商品名识别模型
ITEM_MODEL=gpt-4o-mini

# Vector Database (Milvus)
MILVUS_URL=http://192.168.85.10:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# Document Database (MongoDB)
MONGO_URL=mongodb://192.168.85.10:27017
MONGO_DB_NAME=kb001

# Object Storage (MinIO)
MINIO_ENDPOINT=192.168.85.10:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-real-password
MINIO_BUCKET_NAME=knowledge-base
